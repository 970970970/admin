{
  "type": "page",
  "title": "品牌管理",
  "body": {
    "type": "crud",
    "api": "${API_HOST}/v1/brands/secure/list?limit=${perPage}&offset=${(page-1)*perPage}&keywords=${keywords}",
    "filter": {
      "title": "",
      "mode": "inline",
      "wrapWithPanel": false,
      "submitText": "",
      "controls": [
        {
          "type": "text",
          "name": "keywords",
          "placeholder": "通过关键字搜索",
          "addOn": {
            "label": "搜索",
            "type": "submit",
            "className": "btn-success"
          },
          "clearable": true
        }
      ],
      "className": "m-b-sm"
    },
    "headerToolbar": [
      {
        "type": "button",
        "label": "新增品牌",
        "icon": "fa fa-plus",
        "actionType": "dialog",
        "dialog": {
          "title": "新增品牌",
          "size": "lg",
          "body": {
            "type": "form",
            "api": "post:${API_HOST}/v1/brands/secure",
            "body": [
              {
                "type": "input-text",
                "name": "name",
                "label": "品牌名称",
                "required": true,
                "placeholder": "请输入品牌名称"
              },
              {
                "type": "textarea",
                "name": "description",
                "label": "描述",
                "required": true,
                "placeholder": "请输入品牌描述"
              },
              {
                "type": "select",
                "name": "status",
                "label": "状态",
                "required": true,
                "value": "neutral",
                "options": [
                  { "label": "支持", "value": "support" },
                  { "label": "中立", "value": "neutral" },
                  { "label": "抵制", "value": "avoid" }
                ]
              },
              {
                "type": "picker",
                "name": "logo_media_id",
                "label": "Logo",
                "source": "${API_HOST}/v1/media/secure/list",
                "size": "lg",
                "pickerSchema": {
                  "mode": "table",
                  "name": "thelist",
                  "columns": [
                    {
                      "name": "id",
                      "label": "ID"
                    },
                    {
                      "name": "preview",
                      "label": "预览",
                      "type": "image",
                      "src": "${MEDIA_HOST}/${path}",
                      "enlargeAble": true,
                      "thumbMode": "contain",
                      "thumbRatio": "4:3"
                    },
                    {
                      "name": "description",
                      "label": "描述"
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    ],
    "perPage": 10,
    "syncLocation": false,
    "columns": [
      {
        "name": "id",
        "label": "ID",
        "width": 80
      },
      {
        "name": "logo",
        "label": "Logo",
        "type": "image",
        "src": "${logo_media_id ? `${MEDIA_HOST}/${logo_path}` : ''}",
        "enlargeAble": true,
        "thumbMode": "contain",
        "thumbRatio": "4:3",
        "width": 100,
        "height": 75,
        "placeholder": "暂无图片"
      },
      {
        "name": "name",
        "label": "品牌名称",
        "sortable": true
      },
      {
        "name": "status",
        "label": "状态",
        "type": "mapping",
        "map": {
          "support": "支持",
          "neutral": "中立",
          "avoid": "抵制"
        }
      },
      {
        "name": "description",
        "label": "描述",
        "width": 300
      },
      {
        "type": "operation",
        "label": "操作",
        "buttons": [
          {
            "type": "button",
            "label": "编辑",
            "actionType": "dialog",
            "dialog": {
              "title": "编辑品牌",
              "size": "lg",
              "body": {
                "type": "form",
                "api": "put:${API_HOST}/v1/brands/secure/${id}",
                "initApi": "${API_HOST}/v1/brands/secure/${id}",
                "body": [
                  {
                    "type": "input-text",
                    "name": "name",
                    "label": "品牌名称",
                    "required": true,
                    "placeholder": "请输入品牌名称"
                  },
                  {
                    "type": "textarea",
                    "name": "description",
                    "label": "描述",
                    "required": true,
                    "placeholder": "请输入品牌描述"
                  },
                  {
                    "type": "select",
                    "name": "status",
                    "label": "状态",
                    "required": true,
                    "options": [
                      { "label": "支持", "value": "support" },
                      { "label": "中立", "value": "neutral" },
                      { "label": "抵制", "value": "avoid" }
                    ]
                  },
                  {
                    "type": "picker",
                    "name": "logo_media_id",
                    "label": "Logo",
                    "source": "${API_HOST}/v1/media/secure/list",
                    "size": "lg",
                    "pickerSchema": {
                      "mode": "table",
                      "name": "thelist",
                      "columns": [
                        {
                          "name": "id",
                          "label": "ID"
                        },
                        {
                          "name": "preview",
                          "label": "预览",
                          "type": "image",
                          "src": "${MEDIA_HOST}/${path}",
                          "enlargeAble": true,
                          "thumbMode": "contain",
                          "thumbRatio": "4:3"
                        },
                        {
                          "name": "description",
                          "label": "描述"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          },
          {
            "type": "button",
            "label": "删除",
            "level": "danger",
            "actionType": "ajax",
            "confirmText": "确定要删除该品牌吗？",
            "api": "delete:${API_HOST}/v1/brands/secure/${id}"
          }
        ]
      }
    ]
  }
} 