{
  "type": "page",
  "title": "资源管理",
  "body": {
    "type": "crud",
    "api": "${API_HOST}/v1/media/secure/list?limit=${perPage}&offset=${(page-1)*perPage}&keywords=${keywords}",
    "filter": {
      "title": "",
      "mode": "inline",
      "wrapWithPanel": false,
      "submitText": "",
      "controls": [
        {
          "type": "text",
          "name": "keywords",
          "placeholder": "通过路径或描述搜索",
          "addOn": {
            "label": "搜索",
            "type": "submit",
            "className": "btn-success"
          },
          "clearable": true
        }
      ],
      "className": "m-b-sm"
    },
    "perPage": 10,
    "syncLocation": false,
    "headerToolbar": [
      {
        "type": "button",
        "label": "上传资源",
        "icon": "fa fa-plus",
        "actionType": "dialog",
        "dialog": {
          "title": "上传资源",
          "size": "lg",
          "body": {
            "type": "form",
            "api": {
              "method": "post",
              "url": "${API_HOST}/v1/media/secure/upload/confirm",
              "data": {
                "file": "${file}",
                "path": "${file.value}",
                "description": "${description}"
              }
            },
            "body": [
              {
                "type": "input-file",
                "name": "file",
                "label": "文件",
                "accept": "image/*,video/*,audio/*,.pdf,.doc,.docx,.xls,.xlsx",
                "maxSize": 52428800,
                "required": true,
                "receiver": "${API_HOST}/v1/media/secure/upload/tmp",
                "autoFill": {
                  "value": "$$response.data.path"
                }
              },
              {
                "type": "textarea",
                "name": "description",
                "label": "描述"
              }
            ]
          }
        }
      }
    ],
    "columns": [
      {
        "name": "id",
        "label": "ID",
        "width": 80
      },
      {
        "name": "path",
        "label": "路径",
        "width": 200
      },
      {
        "name": "url",
        "label": "预览",
        "type": "image",
        "src": "${MEDIA_HOST}/${path}",
        "enlargeAble": true,
        "thumbMode": "contain",
        "thumbRatio": "4:3",
        "width": 100,
        "height": 75
      },
      {
        "name": "content_type",
        "label": "文件类型",
        "width": 150
      },
      {
        "name": "size",
        "label": "大小",
        "type": "tpl",
        "tpl": "${ROUND(size/1024)} KB",
        "width": 100
      },
      {
        "name": "description",
        "label": "描述"
      },
      {
        "name": "upload_time",
        "label": "上传时间",
        "type": "datetime",
        "width": 150
      },
      {
        "type": "operation",
        "label": "操作",
        "buttons": [
          {
            "type": "button",
            "label": "编辑",
            "actionType": "dialog",
            "dialog": {
              "title": "编辑文件信息",
              "size": "lg",
              "body": {
                "type": "form",
                "api": "put:${API_HOST}/v1/media/secure/${id}",
                "initApi": "${API_HOST}/v1/media/secure/${id}",
                "body": [
                  {
                    "type": "input-file",
                    "name": "file",
                    "label": "文件",
                    "accept": "image/*,video/*,audio/*,.pdf,.doc,.docx,.xls,.xlsx",
                    "maxSize": 52428800,
                    "receiver": "${API_HOST}/v1/media/secure/upload/tmp",
                    "autoFill": {
                      "value": "$$response.data.path"
                    },
                    "description": "如果不上传新文件则保持原文件不变"
                  },
                  {
                    "type": "textarea",
                    "name": "description",
                    "label": "描述"
                  }
                ]
              }
            }
          },
          {
            "type": "button",
            "label": "删除",
            "level": "danger",
            "actionType": "ajax",
            "confirmText": "确定要删除该文件吗？",
            "api": "delete:${API_HOST}/v1/media/secure/${id}"
          }
        ]
      }
    ],
    "footable": {
      "expand": "all"
    },
    "alwaysShowPagination": true,
    "perPageAvailable": [
      10,
      20,
      50,
      100
    ]
  }
}